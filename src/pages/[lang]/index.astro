---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import Problem from '../../components/sections/Problem.astro';
import Solution from '../../components/sections/Solution.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import ForWhom from '../../components/sections/ForWhom.astro';
import Demo from '../../components/sections/Demo.astro';
import WhyUs from '../../components/sections/WhyUs.astro';
import Packages from '../../components/sections/Packages.astro';
import Team from '../../components/sections/Team.astro';
import Investors from '../../components/sections/Investors.astro';
import Faq from '../../components/sections/Faq.astro';
import Contact from '../../components/sections/Contact.astro';
import { languages, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
---

<Base lang={lang} title={dict.meta.title} description={dict.meta.description} overHero>
  <Hero lang={lang} />
  <Problem lang={lang} />
  <Solution lang={lang} />
  <HowItWorks lang={lang} />
  <ForWhom lang={lang} />
  <Demo lang={lang} />
  <WhyUs lang={lang} />
  <Packages lang={lang} />
  <Team lang={lang} />
  <Investors lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</Base>
