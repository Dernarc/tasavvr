---
import { languageNames, languages, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
  label: string;
  /** "compact": a small dropdown for the phone header. */
  compact?: boolean;
}

const { lang, path, label, compact = false } = Astro.props;
---

{
  compact ? (
    <details class="lang-compact">
      <summary aria-label={`${label}: ${languageNames[lang].long}`}>{languageNames[lang].short}</summary>
      <ul>
        {languages.map((l) => (
          <li>
            <a href={`/${l}/${path}`} hreflang={l} lang={l} data-set-lang={l} aria-current={l === lang ? 'true' : undefined}>
              {languageNames[l].long}
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <nav class="lang" aria-label={label}>
      <ul>
        {languages.map((l) => (
          <li>
            <a
              href={`/${l}/${path}`}
              hreflang={l}
              lang={l}
              data-set-lang={l}
              aria-current={l === lang ? 'true' : undefined}
              aria-label={languageNames[l].long}
            >
              {languageNames[l].short}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .lang ul {
    display: flex;
    list-style: none;
  }

  .lang a,
  .lang-compact summary {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--concrete);
    text-decoration: none;
  }

  .lang a:hover {
    color: var(--drafting-paper);
  }

  .lang a[aria-current] {
    color: var(--plan-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .lang-compact {
    position: relative;
  }

  .lang-compact summary {
    list-style: none;
    cursor: pointer;
    color: var(--drafting-paper);
  }

  .lang-compact summary::-webkit-details-marker {
    display: none;
  }

  .lang-compact ul {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    list-style: none;
    min-width: 160px;
    background: var(--graphite);
    border: 1px solid var(--line-strong);
    padding: 4px 0;
    z-index: 60;
  }

  .lang-compact li a {
    display: block;
    padding: 12px 16px;
    color: var(--drafting-paper);
    text-decoration: none;
  }

  .lang-compact li a[aria-current] {
    color: var(--plan-teal);
  }
</style>
