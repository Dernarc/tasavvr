---
/**
 * Roadmap timeline + one funding panel (§4.10). The full budget and revenue
 * forecast stay in the deck, sent on request.
 */
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const decimal = (n: number) => (lang === 'en' ? String(n) : String(n).replace('.', ','));
---

<section id="investors" class="section" aria-labelledby="investors-title">
  <div class="container">
    <div class="section-head">
      <h2 id="investors-title">{dict.investors.heading}</h2>
    </div>

    <ol class="timeline">
      {
        dict.investors.timeline.map((stage, i) => (
          <li class:list={{ done: i === 0, next: i === 1 }}>
            <span class="dot" aria-hidden="true" />
            <h3>{stage.when}</h3>
            <ul>
              {stage.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <p class="goal">{dict.investors.goal}</p>

    <div class="funding">
      <p class="raising">{dict.investors.raising}</p>

      <figure class="split">
        <figcaption class="split-title">{dict.investors.splitLabel}</figcaption>
        <!-- Bar is decorative for screen readers; the legend below carries every value. -->
        <div class="bar" aria-hidden="true">
          {
            dict.investors.uses.map((use, i) => (
              <span class="seg" style={`--share: ${use.share}; --c: var(--s${i + 1})`} data-tip={`${use.label}: ${decimal(use.share)}%`} />
            ))
          }
        </div>
        <ul class="legend">
          {
            dict.investors.uses.map((use, i) => (
              <li>
                <span class="swatch" style={`--c: var(--s${i + 1})`} aria-hidden="true" />
                <span class="label">{use.label}</span>
                <span class="value">{decimal(use.share)}%</span>
              </li>
            ))
          }
        </ul>
      </figure>

      <div class="btn-row">
        <a href="#contact" class="btn btn-primary" data-role-preset="investor">{dict.investors.cta}</a>
      </div>
      {dict.investors.closing && <p class="closing">{dict.investors.closing}</p>}
    </div>
  </div>
</section>

<style>
  /* Timeline: vertical on phones, horizontal on computers */
  .timeline {
    list-style: none;
    display: grid;
    position: relative;
  }

  .timeline > li {
    position: relative;
    padding: 0 0 28px 36px;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 16px;
    bottom: 0;
    width: 1px;
    background: var(--line-strong);
  }

  .timeline > li:last-child::before {
    display: none;
  }

  .dot {
    position: absolute;
    left: 0;
    top: 4px;
    width: 15px;
    height: 15px;
    border: 1px solid var(--plan-teal);
    background: var(--blueprint-night);
  }

  .done .dot {
    background: var(--plan-teal);
  }

  .next .dot {
    border-style: dashed;
    border-width: 2px;
  }

  .timeline h3 {
    font-size: var(--h3);
    margin-bottom: 8px;
  }

  .done h3 {
    color: var(--plan-teal);
  }

  .timeline ul {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    color: var(--concrete);
    font-size: 16px;
  }

  .goal {
    margin-top: 24px;
    font-family: var(--font-heading);
    font-size: var(--h3);
    line-height: 1.3;
    color: var(--plan-teal);
    max-width: 40rem;
  }

  /* Funding panel */
  .funding {
    margin-top: 48px;
    padding: 28px 20px;
    background: var(--graphite);
    border: 1px solid var(--line);
    display: grid;
    gap: 28px;
    /* Categorical steps validated on the Graphite surface (dataviz validator:
       adjacent CVD ΔE ≥ 8.4, normal-vision ΔE ≥ 19.3, all ≥ 3:1). */
    --s1: #3987e5;
    --s2: #d95926;
    --s3: #199e70;
    --s4: #c98500;
    --s5: #d55181;
  }

  .raising {
    font-family: var(--font-heading);
    font-size: var(--h3);
    line-height: 1.35;
    max-width: 44rem;
  }

  .split {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .split-title {
    font-size: var(--small);
    font-weight: 600;
    color: var(--concrete);
  }

  .bar {
    display: flex;
    gap: 2px;
    height: 20px;
  }

  .seg {
    position: relative;
    flex: var(--share) 1 0;
    min-width: 4px;
    background: var(--c);
  }

  .seg:first-child {
    border-radius: 4px 0 0 4px;
  }

  .seg:last-child {
    border-radius: 0 4px 4px 0;
  }

  /* Hover tooltip (pointer devices); the legend holds every value anyway. */
  .seg::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 10px;
    white-space: nowrap;
    font-size: 13px;
    background: var(--blueprint-night);
    color: var(--drafting-paper);
    border: 1px solid var(--line-strong);
    opacity: 0;
    pointer-events: none;
  }

  .seg:first-child::after {
    left: 0;
    transform: none;
  }

  .seg:nth-last-child(-n + 2)::after {
    left: auto;
    right: 0;
    transform: none;
  }

  @media (hover: hover) {
    .seg:hover::after {
      opacity: 1;
    }
  }

  .legend {
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 15px;
  }

  .legend li {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    gap: 10px;
    align-items: baseline;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--c);
    align-self: center;
  }

  .value {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .closing {
    color: var(--concrete);
    font-style: italic;
    font-size: 16px;
  }

  @media (min-width: 900px) {
    .timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }

    .timeline > li {
      padding: 36px 0 0;
    }

    .timeline > li::before {
      left: 16px;
      right: -24px;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .dot {
      top: 0;
    }

    .funding {
      padding: 40px;
    }

    .legend {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 40px;
    }
  }
</style>
